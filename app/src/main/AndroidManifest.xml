<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <application
        android:localeConfig="@xml/kookyar_locales_config"
        android:allowBackup="true"
        android:icon="@mipmap/kookyar"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:supportsRtl="true">

        <activity
            android:name=".PianoTuner"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/DisableSoundEffects"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="org.puredata.android.service.PdService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <activity
            android:name=".Prefs"
            android:label="@string/tanzimat"
            android:exported="false" />
    </application>
</manifest>
