<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tuner_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="locale"
    android:background="@color/surfaceColor">

    <include layout="@layout/app_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp">

            <!-- Keyboard card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/cardColor"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/cardStroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="14dp"
                        android:text="@string/key_select"
                        android:textColor="@color/onSurfaceVariant"
                        android:textSize="13sp"
                        android:letterSpacing="0.02" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layoutDirection="ltr"
                        android:scrollbars="none"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:clipToPadding="false">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/octave_0"
                                style="@style/Widget.App.OctaveChip" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/octave_1"
                                style="@style/Widget.App.OctaveChip" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/octave_2"
                                style="@style/Widget.App.OctaveChip" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/octave_3"
                                style="@style/Widget.App.OctaveChip" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/octave_4"
                                style="@style/Widget.App.OctaveChip" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/octave_5"
                                style="@style/Widget.App.OctaveChip" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/octave_6"
                                style="@style/Widget.App.OctaveChip" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/octave_7"
                                style="@style/Widget.App.OctaveChip" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <com.PouyaApp.kookyarpiano.PianoKeyboardView
                        android:id="@+id/keyboard"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layoutDirection="ltr" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="14dp"
                        android:background="@color/cardStroke" />

                    <LinearLayout
                        android:id="@+id/tuning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/tuning"
                            android:textColor="@color/onSurface"
                            android:textSize="16sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/checkBox_tuning"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:clickable="false" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/pitch_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="12dp"
                android:text=""
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/accentColor" />

            <TextView
                android:id="@+id/key_hz_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="8dp"
                android:text=""
                android:textSize="13sp"
                android:textColor="@color/onSurfaceVariant" />

            <com.kookyar.common.PitchView
                android:id="@+id/pitch_view"
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:layout_marginBottom="12dp" />
        </LinearLayout>
    </ScrollView>

    <com.kookyar.common.FeatureBar
        android:id="@+id/feature_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cardColor" />
</LinearLayout>
